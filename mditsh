VERSION=2.0.1

# WebPath and URL parsing
set -o pipefail
trap 'printf "\rBye! \n";exit 0' INT
trap 'printf "\r-> /sidebar \n";exec $0 /sidebar --continue' TSTP
trap 'printf "\r-<topbar \n";exec $0 $WEBPATH --othercontinue' SIGQUIT
WEBPATH="$1"
: "${WEBPATH:=home}"
if [ "$WEBPATH" == "/" ]; then
  WEBPATH="/home"
fi
case "$WEBPATH" in
  http://*|https://*)
    xdg-open "$WEBPATH"
    WEBPATH="/home"
    ;;
  /*)
    ;;
  *)
    WEBPATH="/$WEBPATH"
    ;;
esac

: "${CONFIGDOTJSON:=https://wiki.obsidianos.xyz/config.json}"
if [ -z "$2" ]; then
  echo "Welcome to MDITsh $VERSION! Type in the path."
  echo "^C exit ^Z open sidebar ^D reload ^\\ topbar"
  printf "Connecting to $CONFIGDOTJSON...\r"
fi
URL="$(curl -fsSL $CONFIGDOTJSON | jq -r '.baseUrl')"
LOGO="$(curl -fsSL $CONFIGDOTJSON | jq -r '.logo')"
NAME="$(curl -fsSL $CONFIGDOTJSON | jq -r '.siteName')"
LICENCE="$(curl -fsSL $CONFIGDOTJSON | jq -r '.licenseBadge')"
# styling
format_text() {
  sed -E '
  # Replace %GAP% with |
  s/%GAP%/|/g

  # Markdown links: [text](url) -> text [url], no color
  s/\[([^]]*)\]\(([^)]*)\)/\1 [\2]/g

  # Headers: #, ##, ###, #### -> yellow
  s/^(#{1,4}) (.*)/\x1b[33m\2\x1b[0m/

  # Quote line: "> " to "| "
  s/^> /| /

  # Bold: **text** (does not clear color)
  s/\*\*([^*]+)\*\*/\x1b[1m\1\x1b[22m/g

  # Italic: *text* (does not clear color)
  s/\*([^*]+)\*/\x1b[3m\1\x1b[23m/g

  # Inline code: `text` -> grey bg, white text
  s/`([^`]+)`/\x1b[100;97m\1\x1b[0m/g
  '
}
# rendering
moreable() {
  if command -v more >/dev/null; then more
  else                                 cat
  fi
}
if [ "$2" == "--continue" ]; then
  curl -fsSL "$URL/$WEBPATH.md"|format_text|moreable
else
  LICENCETEXT="$(printf '%s\n' "$LICENCE" \
    | sed -n 's/.*alt="\([^"]*\)".*/ - \1/p')"
  printf "$NAME$LICENCETEXT | "
  curl -fsSL "$URL/top.md"|format_text
fi
# input parsing
printf -- "-> "
read input
if [ -n "$input" ]; then
  exec $0 "$input" --continue
else
  if [ "$WEBPATH" == "/home" ]; then
    echo "/"
  else
    echo "$WEBPATH"
  fi
  exec $0 "$WEBPATH" --continue
fi
